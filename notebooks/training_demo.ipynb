   "source": [
    "# Attention-LSTM: Datacenter Failure Prediction\\n",
    "\\n",
    "This interactive notebook demonstrates the pipeline for ingesting continuous networking telemetry, compiling the sequenced Autoencoder, and detecting failure probability.\\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\\n",
    "import sys\\n",
    "sys.path.append(os.path.abspath('..'))\\n",
    "from data.preprocessing import process_telemetry_data\\n",
    "from src.model import create_sequences\\n",
    "\\n",
    "train_path = '../telemetry/optical-failure-dataset/SoftFailure_dataset.csv'\\n",
    "test_path = '../telemetry/optical-failure-dataset/HardFailure_dataset.csv'\\n",
    "\\n",
    "X_train_raw, y_train_raw, features = process_telemetry_data(train_path)\\n",
    "X_test_raw, y_test_raw, _ = process_telemetry_data(test_path)\\n",
    "\\n",
    "print(f\\\"Loaded Soft Failure Sequences: {len(X_train_raw)}\\\")\\n",
    "print(f\\\"Loaded Hard Failure Sequences: {len(X_test_raw)}\\\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.preprocessing import StandardScaler\\n",
    "\\n",
    "scaler = StandardScaler()\\n",
    "X_train_scaled = scaler.fit_transform(X_train_raw)\\n",
    "X_test_scaled = scaler.transform(X_test_raw)\\n",
    "\\n",
    "X_train, y_train = create_sequences(X_train_scaled, y_train_raw, seq_length=15)\\n",
    "X_test, y_test = create_sequences(X_test_scaled, y_test_raw, seq_length=15)\\n",
    "\\n",
    "print(f\\\"Trailing Shape: {X_train.shape}\\\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import torch\\n",
    "from src.model import AttentionLSTM\\n",
    "\\n",
    "device = torch.device('cuda' if torch.cuda.is_available() else 'cpu')\\n",
    "model = AttentionLSTM(input_size=len(features)).to(device)\\n",
    "\\n",
    "# See test.py or inference.py for full training and execution logic.\\n",
    "print(\\\"LSTM + Self-Attention Architecture initialized successfully.\\\")"
   ]
  }
